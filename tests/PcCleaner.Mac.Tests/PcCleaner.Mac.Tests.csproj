<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>PcCleaner.Mac.Tests</RootNamespace>
    <!-- Tests are short; passing TestContext.Current.CancellationToken everywhere would only add noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PcCleaner.Mac\PcCleaner.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured macOS tool output (Fixture.Text). -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Packaging files checked by Packaging/*Tests. -->
    <None Include="..\..\src\PcCleaner.Mac\Assets\AppIcon.icns" Link="Assets\AppIcon.icns" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\mac\Info.plist" Link="Assets\Info.plist" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\update-signing-public.pem" Link="update-signing-public.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
