<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PcCleaner</RootNamespace>
    <AssemblyName>WaterCa7sPcCleaner</AssemblyName>
    <Version>1.0.0</Version>
    <Product>WaterCa7s PC Cleaner</Product>
    <Company>WaterCa7</Company>
    <Copyright>© 2026 WaterCa7</Copyright>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The screenshot mode renders pages without a screen. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcCleaner.Mac.Tests" />
  </ItemGroup>

</Project>
