<!-- Colors and brushes of the Windows version (src/PcCleaner/Themes/Theme.xaml there): the same keys, the same values. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BackgroundColor">#0F1218</Color>
  <Color x:Key="SidebarColor">#0B0E13</Color>
  <Color x:Key="SurfaceColor">#171B23</Color>
  <Color x:Key="Surface2Color">#1F242E</Color>
  <Color x:Key="Surface3Color">#293040</Color>
  <Color x:Key="LineColor">#2A3140</Color>
  <Color x:Key="TextColor">#E7EAF0</Color>
  <Color x:Key="MutedColor">#8E98AA</Color>
  <Color x:Key="AccentColor">#34D399</Color>
  <Color x:Key="AccentHoverColor">#5EE6B0</Color>
  <Color x:Key="AccentPressedColor">#22B37F</Color>
  <Color x:Key="DangerColor">#F87171</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="SuccessColor">#34D399</Color>
  <Color x:Key="InfoColor">#60A5FA</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#06261A" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A34D399" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#22F87171" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#22FBBF24" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A34D399" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
  <SolidColorBrush x:Key="InfoSoftBrush" Color="#2260A5FA" />
  <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SelectionBrush" Color="#2634D399" />

  <!-- The app logo (a drop with cat ears), the same 100x100 drawing as tools/mac/make-icon.ps1. -->
  <StreamGeometry x:Key="LogoDrop">M27,18 L40,35 Q50,31 60,35 L73,18 L75,45 C80,52 78,58 78,62 A28,28 0 0 1 22,62 C22,58 20,52 25,45 Z</StreamGeometry>
</ResourceDictionary>
