<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PcCleaner.Modules.Cleaner"
             x:Class="PcCleaner.Modules.Cleaner.CleanerView"
             x:DataType="vm:CleanerViewModel">
  <TabControl>

    <!-- ===================== Очистка ===================== -->
    <TabItem Header="Очистка">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,12,8,8">

          <Border Classes="Card">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="Проверить снова" Command="{Binding ScanCommand}" />
                <Button Classes="AccentButton" Command="{Binding CleanCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Broom}" />
                    <TextBlock Text="{Binding CleanButtonText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="H3" Text="Что можно очистить" />
                <TextBlock Classes="Muted"
                           Text="Отмеченное удалится без Корзины: это временные файлы, программы создадут их заново. Пароли, история браузеров и ваши документы не трогаются." />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Padding="12,9" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding HasLastResult}">
            <DockPanel>
              <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                        Data="{StaticResource Icon.Checkmark}" Foreground="{StaticResource AccentBrush}" />
              <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>

          <Border Classes="InnerCard" IsVisible="{Binding ShowFdaHint}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Открыть настройки" Command="{Binding OpenFdaSettingsCommand}" Margin="12,0,0,0" />
              <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource Icon.Lock}"
                        Foreground="{StaticResource InfoBrush}" />
              <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                         Text="С полным доступом к диску программа проверит ещё Корзину и кэш Safari (Настройки → «Полный доступ к диску»)." />
            </DockPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Categories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryItem">
                <Border Classes="Card" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,-4,4,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Classes="Muted" Text="{Binding Description}" />
                      <TextBlock Text="{Binding StateText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                      <Button Classes="LinkButton" Content="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}"
                              IsVisible="{Binding HasDetails}" HorizontalAlignment="Left" Margin="0,2,0,0" FontSize="12.5" />
                      <Border Classes="InnerCard" Padding="10,6" IsVisible="{Binding ShowDetails}">
                        <ItemsControl ItemsSource="{Binding Details}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetLine">
                              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <StackPanel>
                                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5" />
                                  <TextBlock Classes="Muted" Text="{Binding SkipReason}" IsVisible="{Binding HasSkipReason}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12.5" Margin="12,0,0,0" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold" Margin="16,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The Trash: never part of «Очистить выбранное». -->
          <Border Classes="Card">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Width="20" Height="20" Margin="2,0,12,0" VerticalAlignment="Top" Data="{StaticResource Icon.Dismiss}"
                        Foreground="{StaticResource MutedBrush}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding TrashCategory.Title}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Classes="Muted" Text="{Binding TrashCategory.Description}" />
                <TextBlock Classes="Muted" Text="{Binding TrashCategory.StateText}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="8" Margin="16,0,0,0" HorizontalAlignment="Right">
                <TextBlock Text="{Binding TrashCategory.SizeText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <Button Classes="DangerButton" Content="Очистить корзину" Command="{Binding EmptyTrashCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- ===================== Диски и место ===================== -->
    <TabItem Header="Диски и место">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,12,8,8">

          <ItemsControl ItemsSource="{Binding Volumes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VolumeItem">
                <Border Classes="Card" Margin="0,0,0,10">
                  <StackPanel Spacing="8">
                    <DockPanel>
                      <PathIcon DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0" Data="{StaticResource Icon.HardDrive}"
                                Foreground="{StaticResource AccentBrush}" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Classes="Muted" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Classes="H3" Text="{Binding Name}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" MinHeight="8" CornerRadius="4" />
                    <TextBlock Classes="Muted" Text="{Binding PurgeableText}" IsVisible="{Binding HasPurgeable}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="InnerCard">
            <TextBlock Text="{Binding SnapshotsText}" TextWrapping="Wrap" FontSize="12.5" />
          </Border>

          <Border Classes="Card">
            <StackPanel Spacing="10">
              <TextBlock Classes="H3" Text="Куда ушло место" />
              <TextBlock Classes="Muted"
                         Text="Папки пользователя считаются только по кнопке. macOS может один раз спросить разрешение на доступ к «Рабочему столу», «Документам» и «Загрузкам» — без него эти папки не посчитать. Найденное можно показать в Finder или переместить в Корзину." />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Самые большие папки" Command="{Binding FindTopFoldersCommand}" Margin="0,0,8,8" />
                <ComboBox ItemsSource="{Binding ThresholdChoices}" SelectedItem="{Binding Threshold}" Margin="0,0,8,8" MinWidth="120" />
                <Button Content="Найти большие файлы" Command="{Binding FindLargeFilesCommand}" Margin="0,0,8,8" />
                <Button Content="Старые загрузки" Command="{Binding FindOldDownloadsCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{Binding AnalysisStatus}" IsVisible="{Binding HasAnalysisStatus}" TextWrapping="Wrap" />

              <StackPanel Spacing="6" IsVisible="{Binding HasTopFolders}">
                <TextBlock Classes="H3" FontSize="13.5" Text="Самые большие папки" />
                <ItemsControl ItemsSource="{Binding TopFolders}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderItem">
                      <Grid ColumnDefinitions="200,*,90,Auto" Margin="0,3">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="6" MinHeight="6" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="GhostButton" Content="Открыть" Command="{Binding RevealCommand}" Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasLargeFiles}">
                <TextBlock Classes="H3" FontSize="13.5" Text="Большие файлы" />
                <ItemsControl ItemsSource="{Binding LargeFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserItemRow">
                      <Grid ColumnDefinitions="*,90,90,Auto,Auto" Margin="0,3">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Muted" Text="{Binding Folder}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="Muted" Text="{Binding DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="GhostButton" Content="Показать" Command="{Binding RevealCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="4" Content="В Корзину" Command="{Binding TrashCommand}" Margin="4,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasOldDownloads}">
                <TextBlock Classes="H3" FontSize="13.5" Text="Не открывались больше 90 дней (Загрузки)" />
                <ItemsControl ItemsSource="{Binding OldDownloads}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserItemRow">
                      <Grid ColumnDefinitions="*,90,90,Auto,Auto" Margin="0,3">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="Muted" Text="{Binding Folder}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="Muted" Text="{Binding DateText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="GhostButton" Content="Показать" Command="{Binding RevealCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="4" Content="В Корзину" Command="{Binding TrashCommand}" Margin="4,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>
