<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PcCleaner.Modules.Cleaner"
             x:Class="PcCleaner.Modules.Cleaner.CleanerView"
             x:DataType="vm:CleanerViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,4,8,8">

      <Border Classes="Card">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="Проверить снова" Command="{Binding ScanCommand}" />
            <Button Classes="AccentButton" Command="{Binding CleanCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Broom}" />
                <TextBlock Text="{Binding CleanButtonText}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Classes="H3" Text="Что можно очистить" />
            <TextBlock Classes="Muted"
                       Text="Отмеченное удалится без Корзины: это временные файлы, программы создадут их заново. Пароли, история браузеров и ваши документы не трогаются." />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Padding="12,9" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding HasLastResult}">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                    Data="{StaticResource Icon.Checkmark}" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <Border Classes="InnerCard" IsVisible="{Binding ShowFdaHint}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Открыть настройки" Command="{Binding OpenFdaSettingsCommand}" Margin="12,0,0,0" />
          <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" Data="{StaticResource Icon.Lock}"
                    Foreground="{StaticResource InfoBrush}" />
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                     Text="С полным доступом к диску программа проверит ещё Корзину и кэш Safari (Настройки → «Полный доступ к диску»)." />
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CategoryItem">
            <Border Classes="Card" Margin="0,0,0,10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,-4,4,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Classes="Muted" Text="{Binding Description}" />
                  <TextBlock Text="{Binding StateText}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                  <Button Classes="LinkButton" Content="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}"
                          IsVisible="{Binding HasDetails}" HorizontalAlignment="Left" Margin="0,2,0,0" FontSize="12.5" />
                  <Border Classes="InnerCard" Padding="10,6" IsVisible="{Binding ShowDetails}">
                    <ItemsControl ItemsSource="{Binding Details}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TargetLine">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12.5" />
                              <TextBlock Classes="Muted" Text="{Binding SkipReason}" IsVisible="{Binding HasSkipReason}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12.5" Margin="12,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="18" FontWeight="SemiBold" Margin="16,0,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The Trash: never part of «Очистить выбранное». -->
      <Border Classes="Card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Width="20" Height="20" Margin="2,0,12,0" VerticalAlignment="Top" Data="{StaticResource Icon.Dismiss}"
                    Foreground="{StaticResource MutedBrush}" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding TrashCategory.Title}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Classes="Muted" Text="{Binding TrashCategory.Description}" />
            <TextBlock Classes="Muted" Text="{Binding TrashCategory.StateText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" Margin="16,0,0,0" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TrashCategory.SizeText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <Button Classes="DangerButton" Content="Очистить корзину" Command="{Binding EmptyTrashCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
