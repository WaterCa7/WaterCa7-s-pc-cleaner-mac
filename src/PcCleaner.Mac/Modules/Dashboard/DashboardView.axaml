<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PcCleaner.Modules.Dashboard"
             xmlns:shell="using:PcCleaner.Shell"
             x:Class="PcCleaner.Modules.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="0,0,8,8">

      <!-- ===== Score ===== -->
      <Border Classes="Card" Padding="22">
        <Grid ColumnDefinitions="Auto,*">
          <Grid Width="136" Height="136" VerticalAlignment="Top">
            <shell:ScoreGauge Value="{Binding ScoreValue}" Thickness="11"
                              TrackBrush="{StaticResource Surface3Brush}"
                              Stroke="{Binding ScoreBrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Classes="BigNumber" FontSize="38" Text="{Binding ScoreText}" HorizontalAlignment="Center" />
              <TextBlock Classes="Muted" Text="из 100" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Column="1" Margin="26,2,0,0" Spacing="8">
            <TextBlock Classes="Muted" Text="СОСТОЯНИЕ MAC" FontSize="11.5" FontWeight="SemiBold" LetterSpacing="0.6" />
            <TextBlock Text="{Binding Verdict}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{Binding ScoreBrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
            <TextBlock Classes="Muted" FontSize="13" Text="{Binding VerdictDescription}" />
            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
              <Border Classes="Chip" Margin="0,0,8,6" IsVisible="{Binding HasScan}">
                <TextBlock Text="{Binding FindingsText}" FontSize="12" />
              </Border>
              <Border Classes="Chip" Margin="0,0,8,6" IsVisible="{Binding HasDelta}">
                <TextBlock Text="{Binding DeltaText}" FontSize="12" />
              </Border>
              <TextBlock Classes="Muted" Text="{Binding LastScanText}" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Classes="AccentButton" Command="{Binding ScanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.ShieldCheckmark}" />
                  <TextBlock Text="{Binding ScanButtonText}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding FixAllCommand}" IsVisible="{Binding HasFixable}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Checkmark}" />
                  <TextBlock Text="{Binding FixAllText}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Warning (failed sections, stopped scan) ===== -->
      <Border Padding="12,9" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" IsVisible="{Binding HasScanWarning}">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                    Data="{StaticResource Icon.Warning}" Foreground="{StaticResource WarningBrush}" />
          <TextBlock Text="{Binding ScanWarning}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- ===== Sections of the scan ===== -->
      <Border Classes="Card" IsVisible="{Binding HasModules}">
        <StackPanel Spacing="8">
          <TextBlock Classes="H3" Text="Разделы" />
          <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModuleRow">
                <Grid ColumnDefinitions="Auto,220,*" Margin="0,4">
                  <Panel Width="10" Height="10" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource MutedBrush}" />
                    <Ellipse Fill="{StaticResource InfoBrush}" IsVisible="{Binding IsRunning}" />
                    <Ellipse Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsDone}" />
                    <Ellipse Fill="{StaticResource DangerBrush}" IsVisible="{Binding IsFailed}" />
                  </Panel>
                  <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="Muted" Text="{Binding StateText}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===== Findings by severity ===== -->
      <ItemsControl ItemsSource="{Binding Groups}" IsVisible="{Binding HasGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IssueGroupItem">
            <StackPanel Spacing="8" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="H3" Text="{Binding Title}"
                           Foreground="{Binding BrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
                <TextBlock Classes="Muted" Text="{Binding Hint}" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:IssueItem">
                    <Border Classes="Card" Padding="14" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="5">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="Badge"
                                    Background="{Binding SeveritySoftBrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}">
                              <TextBlock Text="{Binding SeverityText}" FontSize="11.5" FontWeight="SemiBold"
                                         Foreground="{Binding SeverityBrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Classes="Muted" Text="{Binding Details}" IsVisible="{Binding HasDetails}" />
                          <TextBlock Text="{Binding GainText}" IsVisible="{Binding HasGain}" Foreground="{StaticResource AccentBrush}" FontSize="12.5" />
                          <TextBlock Text="{Binding FixResult}" IsVisible="{Binding HasFixResult}" FontSize="12.5" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFixed}" VerticalAlignment="Center">
                            <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Checkmark}" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="Исправлено" Foreground="{StaticResource SuccessBrush}" />
                          </StackPanel>
                          <Button Content="Исправить" Command="{Binding FixCommand}" IsVisible="{Binding CanFix}" />
                          <Button Classes="GhostButton" Content="Открыть раздел" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ===== This Mac ===== -->
      <Border Classes="Card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Width="18" Height="18" Data="{StaticResource Icon.HardDrive}" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Classes="H3" Text="Этот Mac" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding InfoRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InfoRow">
                <Grid ColumnDefinitions="170,*" Margin="0,3">
                  <TextBlock Classes="Muted" FontSize="13" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
