<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PcCleaner.Modules.Security"
             xmlns:shell="using:PcCleaner.Shell"
             x:Class="PcCleaner.Modules.Security.SecurityView"
             x:DataType="vm:SecurityViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Margin="0,4,8,8">

      <Border Classes="Card">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Проверить снова" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
          <StackPanel Spacing="4">
            <TextBlock Classes="H3" Text="{Binding CardTitle}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap" Text="{Binding Summary}" />
            <TextBlock Classes="Muted" TextWrapping="Wrap" FontSize="12" Text="{Binding NoteText}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Padding="12,9" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding HasLastResult}">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top"
                    Data="{StaticResource Icon.Checkmark}" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CheckGroupItem">
            <StackPanel Spacing="8" Margin="0,0,0,8">
              <TextBlock Classes="H3" Text="{Binding Title}" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckItem">
                    <Border Classes="Card" Padding="14" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top"
                                  Data="{Binding IconName, Converter={x:Static shell:IconConverter.Instance}}"
                                  Foreground="{Binding BrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
                        <StackPanel Grid.Column="1" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding Summary}" FontSize="13"
                                       Foreground="{Binding BrushKey, Converter={x:Static shell:BrushKeyConverter.Instance}}" />
                          </StackPanel>
                          <TextBlock Classes="Muted" Text="{Binding Details}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                          <Button Classes="AccentButton" Content="{Binding FixText}" Command="{Binding FixCommand}" IsVisible="{Binding CanFix}"
                                  HorizontalAlignment="Stretch" />
                          <Button Content="{Binding SettingsText}" Command="{Binding SettingsCommand}" IsVisible="{Binding HasSettings}"
                                  HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ===== Lines of /etc/hosts worth a look ===== -->
      <Border Classes="Card" IsVisible="{Binding HasHostsLines}">
        <StackPanel Spacing="8">
          <TextBlock Classes="H3" Text="Строки файла hosts" />
          <TextBlock Classes="Muted" TextWrapping="Wrap"
                     Text="Отмеченные строки закомментирует кнопка «Закомментировать отмеченные строки» в проверке «Файл hosts» выше: перед ними появится «#», сами строки останутся в файле." />
          <ItemsControl ItemsSource="{Binding HostsLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HostsEntry">
                <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,-4,4,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding RawLine}" FontFamily="Menlo, Consolas, monospace" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Classes="Muted" Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
