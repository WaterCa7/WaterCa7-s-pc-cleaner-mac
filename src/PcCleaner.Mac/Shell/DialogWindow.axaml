<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PcCleaner.Shell.DialogWindow"
        Width="480" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
  <DockPanel Margin="22,20,22,18">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,18,0,0">
      <Button x:Name="NoButton" Content="Нет" MinWidth="88" HorizontalContentAlignment="Center" IsCancel="True" Click="OnNo" />
      <Button x:Name="YesButton" Classes="AccentButton" Content="Да" MinWidth="88" HorizontalContentAlignment="Center" Click="OnYes" />
    </StackPanel>
    <PathIcon x:Name="KindIcon" DockPanel.Dock="Left" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,16,0" />
    <StackPanel Spacing="8">
      <TextBlock x:Name="TitleText" Classes="H3" FontSize="15" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="380">
        <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="19" />
      </ScrollViewer>
    </StackPanel>
  </DockPanel>
</Window>
